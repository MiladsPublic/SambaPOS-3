@page
@model Samba.WebApp.Pages.TicketsModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Tickets</h5>
                <div>
                    <button class="btn btn-sm btn-light" onclick="refreshTickets()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Filter Controls -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="statusFilter">
                            <option value="">All</option>
                            <option value="open">Open</option>
                            <option value="paid">Paid</option>
                            <option value="closed">Closed</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date From</label>
                        <input type="date" class="form-control" id="dateFrom">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date To</label>
                        <input type="date" class="form-control" id="dateTo">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary" onclick="filterTickets()">Filter</button>
                    </div>
                </div>
                
                <!-- Tickets Table -->
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Ticket #</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ticketsTableBody">
                            <tr>
                                <td>T001</td>
                                <td>2025-01-15 10:30</td>
                                <td>3</td>
                                <td>$25.50</td>
                                <td><span class="badge bg-success">Paid</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick="viewTicket(1)">View</button>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="printTicket(1)">Print</button>
                                </td>
                            </tr>
                            <tr>
                                <td>T002</td>
                                <td>2025-01-15 11:15</td>
                                <td>1</td>
                                <td>$12.00</td>
                                <td><span class="badge bg-warning">Open</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" onclick="viewTicket(2)">View</button>
                                    <button class="btn btn-sm btn-outline-success" onclick="continueTicket(2)">Continue</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ticket Detail Modal -->
<div class="modal fade" id="ticketDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ticket Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="ticketDetailContent">
                <!-- Ticket details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="printTicketFromModal()">Print</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tickets.js"></script>
}